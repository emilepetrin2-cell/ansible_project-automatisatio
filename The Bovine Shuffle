#include <iostream>
#include <vector>

using namespace std;

int main() {
    freopen("shuffle.in", "r", stdin);
    freopen("shuffle.out", "w", stdout);

    int n;
    cin >> n;

    vector<int> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    vector<int> id(n);
    for (int i = 0; i < n; i++) {
        cin >> id[i];
    }

    for (int step = 0; step < 3; step++) {
        vector<int> prev_id(n);
        for (int i = 0; i < n; i++) {

            prev_id[i] = id[a[i] - 1];
        }
        id = prev_id; 
    }

    for (int i = 0; i < n; i++) {
        cout << id[i] << "\n";
    }

    return 0;
}
